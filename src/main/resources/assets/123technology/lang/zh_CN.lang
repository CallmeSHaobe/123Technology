ote.tm.vnm.4=§6━━━━━━━━━━━━━━━━━━━━
ote.tm.vnm.5=§6✦ 结构相关(警告:结构非常巨大,小心崩溃)
ote.tm.vnm.6=§b结构 §7 266 × 233 × 266;控制器相对坐标 (133, 115, 129).
ote.tm.vnm.7=§b位置 §7 推荐在y=118放置主机,以及一片相当大的空置域
ote.tm.vnm.8=§b输出 §7 基础并行 2,000,000;只接受激光动力仓.
ote.tm.vnm.9=§b输入 §7 至少一个输入总线或双输入仓;源质由进阶源质存储输入总线(ME)提供.
ote.tm.vnm.10=§b充能 §7 主机输入能源仓只给灵能模块供电,不参与主发电.
ote.tm.vnm.11=§b控制 §7 潜行 + 螺丝刀切换无线输出;普通螺丝刀切换物品输入模式(节点解锁后).
ote.tm.vnm.12=§6━━━━━━━━━━━━━━━━━━━━
ote.tm.vnm.13=§6✦ 发电公式
ote.tm.vnm.14=§7令 A_i 为第 i 种源质数量,H_i 为其热值,R = Σ(A_i × H_i),E = ΣA_i,avgHeat = R / E.
ote.tm.vnm.15=§7H_i 直接以 NEI 中的源质热值为准;无法递归分解的附属源质使用均匀六相向量,但仍参与燃烧.
ote.tm.vnm.16=§aBasePower §7= R / T
ote.tm.vnm.17=§aQualityMultiplier §7= 1 + 0.10 × ln(max(0.01, avgHeat / 40,320))
ote.tm.vnm.18=§aP_j §7= Σ(A_i × H_i × phaseVector_i[j])
ote.tm.vnm.19=§aD §7= clamp((Σ((P_j / R)^2) - 1/6) / (5/6), 0, 1)
ote.tm.vnm.20=§aPhaseMultiplier §7= 1 + B × (1 - D)
ote.tm.vnm.21=§7B:U11 时为 1.00;否则 U5 或 U6 已激活时为 0.80;默认 0.20.星阵轮强制 D = 0.
ote.tm.vnm.22=§aGloriaMultiplier §7= 1 + min(Cap, 35 × GloriaShare / (GloriaShare + 0.10))
ote.tm.vnm.23=§7GloriaShare = GloriaThermal / R;Cap = U19 已激活时 4.0,否则 2.0.
ote.tm.vnm.24=§aEfficiencyMultiplier §7= (1 + 0.05×I_U2 + 0.10×I_U5 + 0.50×I_U11) × (0.20 if materialInputMode else 1)
ote.tm.vnm.25=§aOrdinaryMultiplier §7= 1 + Σ(activeNode.OrdinaryBonus)
ote.tm.vnm.26=§aSpecialMultiplier §7= Stabilizer × Potential × Cycle
ote.tm.vnm.27=§7Stabilizer = 1 + I_stabilizer × (1 + 0.5×I_U16);T1/T2 至少取 2.0.
ote.tm.vnm.28=§7U18 已激活时 Potential = 1 + 0.05×min(P,20) + 0.01×min(max(P-20,0),80) + 0.002×max(P-100,0),否则为 1.
ote.tm.vnm.29=§7Cycle = U22 已激活且下一轮轮次 mod 3 = 0 时取 5,否则取 1.
ote.tm.vnm.30=§aStructureDecay §7= exp(-0.6×(t-1)^2 + 0.7×G(t,1) - 1.1×G(t,2) - 0.2×G(t,3))
ote.tm.vnm.31=§7G(t,w) = (1/Z) × ∫[-0.1,0.1] exp(-(t-w-x)^2 / 0.1) dx;Z 为同一积分在 0 处的值.
ote.tm.vnm.32=§7D_t 依次为 T1 2.013573,T2 0.182691,T3 0.074267,T4 0.004517,T5 0.000068.
ote.tm.vnm.33=§aStructureUpgrade §7= exp(1.0×I_U3) × exp(1.5×(t-1)×I_U2) × exp(1.6×(t-1)×I_U4)
ote.tm.vnm.34=§aPower_core §7= floor[(R/T) × QualityMultiplier × PhaseMultiplier × GloriaMultiplier × EfficiencyMultiplier × OrdinaryMultiplier × SpecialMultiplier × StructureDecay × StructureUpgrade × MaterialPenalty × BloodBonus × StarBonus]
ote.tm.vnm.35=§7MaterialPenalty = 0.20(仅物品输入模式启用时);BloodBonus = 1.15(本轮生命源质足量时);StarBonus = 360(本轮燃烧星阵时).
ote.tm.vnm.36=§aFinalPower §7= min(Long.MAX_VALUE, floor(Power_core × (1 + U26Bonus% / 100) × CatalystPenalty))
ote.tm.vnm.37=§6━━━━━━━━━━━━━━━━━━━━
